{
  "name": "claude-cli-ui",
  "version": "0.1.59",
  "private": true,
  "description": "A focused desktop interface for Claude CLI",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1 --port 4317 --strictPort\" \"wait-on tcp:4317 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:4317 electron .\"",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "npm run typecheck && npm run build && node tests/workflow.mjs && node tests/visual-smoke.mjs",
    "test:visual": "npm run build && node tests/visual-smoke.mjs",
    "test:workflow": "npm run build && node tests/workflow.mjs",
    "preview": "vite preview",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:patch": "npm version patch --no-git-tag-version && npm run dist"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "electron-updater": "^6.8.9",
    "katex": "^0.18.1",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "latest",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "latest",
    "remark-math": "^6.0.0",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/semver": "^7.7.1",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "playwright": "^1.62.0",
    "typescript": "latest",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "com.local.claudedesk",
    "productName": "claude-cli-UI",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "yc-2018",
        "repo": "claude-cli-UI"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}"
    }
  }
}
